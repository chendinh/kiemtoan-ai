# Sao chép file này thành .env.local rồi điền giá trị. Không commit .env.local.
# Phần AI là tùy chọn: không cấu hình thì các luật logic vẫn chạy đầy đủ.

# openai: mọi API tương thích OpenAI (OpenAI, OpenRouter, Azure OpenAI, Groq, Ollama local...)
# anthropic: API Claude của Anthropic
AI_PROVIDER=openai

# Khóa API (bí mật, chỉ dùng ở server)
AI_API_KEY=

# Tên mô hình theo nhà cung cấp, ví dụ: gpt-4o-mini | claude-sonnet-4-5 | llama3.1 (Ollama)
AI_MODEL=

# Địa chỉ gốc của API. Bỏ trống để dùng mặc định:
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com
# Chỉ chấp nhận https (hoặc http://localhost cho mô hình chạy trên máy).
# Ví dụ Ollama: http://localhost:11434/v1
AI_BASE_URL=

# Thời gian chờ tối đa cho một lần gọi AI (mili giây), mặc định 120000
AI_TIMEOUT_MS=120000
